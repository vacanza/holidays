#. Year-end market holiday.
msgid "Feriado bursátil de fin de año"
msgstr "Біржовий вихідний наприкінці року"

#. %s (markets close at 3:00pm).
#, c-format
msgid "%s (el mercado cierra a las 15:00)"
msgstr "%s (закриття ринків з 15:00)"

#. Christmas Eve.
msgid "Nochebuena"
msgstr "Святий вечір"

#. Visit of His Holiness Pope Leo XIV.
msgid "Visita de Su Santidad el Papa León XIV"
msgstr "Візит Його Святості Папи Лева XIV"

#. No local settlement.
msgid "Sin liquidación local"
msgstr "Без місцевих розрахунків"

#. No cable settlement.
msgid "Sin liquidación cable"
msgstr "Без міжнародних розрахунків"

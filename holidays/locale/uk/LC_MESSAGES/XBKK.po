#. %s (in lieu).
#, c-format
msgid "ชดเชย%s"
msgstr "%s (вихідний)"

#. New Year's Day.
msgid "วันขึ้นปีใหม่"
msgstr "Новий рік"

#. Makha Bucha.
msgid "วันมาฆบูชา"
msgstr "Маха Буча"

#. Chakri Memorial Day.
msgid "วันพระบาทสมเด็จพระพุทธยอดฟ้าจุฬาโลกมหาราช และวันที่ระลึกมหาจักรีบรมราชวงศ์"
msgstr "День памʼяті короля Рами I та династії Чакрі"

#. Songkran Festival.
msgid "วันสงกรานต์"
msgstr "Тайський Новий рік"

#. National Labor Day.
msgid "วันแรงงานแห่งชาติ"
msgstr "Національний день праці"

#. Coronation Day.
msgid "วันฉัตรมงคล"
msgstr "День коронації"

#. HM Queen Suthida's Birthday.
msgid "วันเฉลิมพระชนมพรรษาสมเด็จพระนางเจ้าสุทิดา พัชรสุธาพิมลลักษณ พระบรมราชินี"
msgstr "День народження Її Величності королеви Сутіди"

#. Mid-Year Closing Day.
msgid "วันหยุดภาคครึ่งปีของสถาบันการเงินและสถาบันการเงินเฉพาะกิจ"
msgstr "Вихідний середини року для фінансових установ"

#. HM King Maha Vajiralongkorn's Birthday.
msgid ""
"วันเฉลิมพระชนมพรรษาพระบาทสมเด็จพระปรเมนทรรามาธิบดีศรีสินทรมหาวชิราลงกรณ พระวชิรเกล้าเจ้าอยู่หัว"
msgstr "День народження Його Величності короля Маха Вачіралонгкорна"

#. HM Queen Sirikit the Queen Mother's Birthday.
msgid "วันเฉลิมพระชนมพรรษาสมเด็จพระบรมราชชนนีพันปีหลวง"
msgstr "День народження Її Величності королеви-матері Сірікіт"

#. HM Queen Sirikit's Birthday.
msgid "วันเฉลิมพระชนมพรรษาสมเด็จพระนางเจ้าสิริกิติ์ พระบรมราชินีนาถ"
msgstr "День народження Її Величності королеви Сірікіт"

#. National Mother's Day.
msgid "วันแม่แห่งชาติ"
msgstr "Національний день матері"

#. HM King Bhumibol Adulyadej Memorial Day.
msgid "วันนวมินทรมหาราช"
msgstr "День памʼяті Його Величності короля Пуміпона Адульядета"

#. Anniversary for the Death of King Bhumibol Adulyadej the Great.
msgid "วันคล้ายวันสวรรคตพระบาทสมเด็จพระบรมชนกาธิเบศร มหาภูมิพลอดุลยเดชมหาราช บรมนาถบพิตร"
msgstr "Річниця смерті Його Величності короля Пуміпона Адульядета Великого"

#. Anniversary for the Death of King Bhumibol Adulyadej.
msgid "วันคล้ายวันสวรรคตพระบาทสมเด็จพระปรมินทรมหาภูมิพลอดุลยเดช บรมนาถบพิตร"
msgstr "Річниця смерті Його Величності короля Пуміпона Адульядета"

#. HM King Chulalongkorn Memorial Day.
msgid "วันปิยมหาราช"
msgstr "День памʼяті Його Величності короля Чулалонгкорна"

#. HM King Bhumibol Adulyadej the Great's Birthday Anniversary.
msgid "วันคล้ายวันเฉลิมพระชนมพรรษาพระบาทสมเด็จพระบรมชนกาธิเบศร มหาภูมิพลอดุลยเดชมหาราช บรมนาถบพิตร"
msgstr "Річниця дня народження Його Величності короля Пуміпона Адульядета Великого"

#. HM King Bhumibol Adulyadej Birthday Anniversary.
msgid "วันคล้ายวันเฉลิมพระชนมพรรษาพระบาทสมเด็จพระปรมินทรมหาภูมิพลอดุลยเดช บรมนาถบพิตร"
msgstr "Річниця дня народження Його Величності короля Пуміпона Адульядета"

#. HM King Bhumibol Adulyadej Birthday Anniversary.
msgid "วันเฉลิมพระชนมพรรษาพระบาทสมเด็จพระปรมินทรมหาภูมิพลอดุลยเดช บรมนาถบพิตร"
msgstr "День народження Його Величності короля Пуміпона Адульядета"

#. National Day.
msgid "วันชาติ"
msgstr "Національний день"

#. National Father's Day.
msgid "วันพ่อแห่งชาติ"
msgstr "Національний день батька"

#. Constitution Day.
msgid "วันรัฐธรรมนูญ"
msgstr "День Конституції"

#. New Year's Eve.
msgid "วันสิ้นปี"
msgstr "Переддень Нового року"

#. Asarnha Bucha.
msgid "วันอาสาฬหบูชา"
msgstr "Асарна Буча"

#. Buddhist Lent Day.
msgid "วันเข้าพรรษา"
msgstr "Початок буддистського посту"

#. Visakha Bucha.
msgid "วันวิสาขบูชา"
msgstr "Вісака Буча"

#. Special In-Lieu Holiday.
msgid "วันหยุดชดเชย"
msgstr "Додатковий вихідний"

#. Bridge Public Holiday.
msgid "วันหยุดพิเศษ (เพิ่มเติม)"
msgstr "Проміжний вихідний"

#. Thai Election Day.
msgid "วันเลือกตั้ง"
msgstr "День виборів"

#. HM King Bhumibol Adulyadej's 60th Anniversary of Accession Event.
msgid "พระราชพิธีฉลองสิริราชสมบัติครบ 60 ปี พ.ศ. 2549"
msgstr "60-та річниця сходження на престол Його Величності короля Пуміпона Адульядета"

#. HM King Bhumibol Adulyadej's Golden Jubilee.
msgid "พระราชพิธีกาญจนาภิเษก พ.ศ. 2539"
msgstr "Золотий ювілей Його Величності короля Пуміпона Адульядета"

#. HM King Bhumibol Adulyadej's Royal Cremation Ceremony.
msgid "วันพระราชพิธีถวายพระเพลิงพระบรมศพพระบาทสมเด็จพระปรมินทรมหาภูมิพลอดุลยเดช"
msgstr "Церемонія кремації Його Величності короля Пуміпона Адульядета"

#. HM King Maha Vajiralongkorn's Coronation Celebrations.
msgid "พระราชพิธีบรมราชาภิเษก พระบาทสมเด็จพระวชิรเกล้าเจ้าอยู่หัว"
msgstr "Коронація Його Величності короля Маха Вачіралонгкорна"

#. %s (estimated).
#, c-format
msgid "%s (e vlerësuar)"
msgstr "%s (tahmini)"

#. %s (observed).
#, c-format
msgid "%s (ditë pushimi e shtyrë)"
msgstr "%s (telafi tatili)"


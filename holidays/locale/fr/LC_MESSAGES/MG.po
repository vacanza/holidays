#. New Year's Day.
msgid "Taom-baovao"
msgstr "Jour de l'an"

#. Women's Day.
msgid "Fetin'ny vehivavy"
msgstr "Journée de la femme"

#. Martyrs' Day.
msgid "Fetin'ny mahery fo"
msgstr "Journée des Martyrs"

#. Easter Sunday.
msgid "Fetin'ny paska"
msgstr "Dimanche de Pâques"

#. Easter Monday.
msgid "Alatsinain'ny paska"
msgstr "Lundi de Pâques"

#. Labor Day.
msgid "Fetin'ny asa"
msgstr "Fête du Travail"

#. Ascension Day.
msgid "Fiakaran'ny Jesosy kristy tany an-danitra"
msgstr "Ascension"

#. Pentecost.
msgid "Pentekosta"
msgstr "Pentecôte"

#. Pentecost Monday.
msgid "Alatsinain'ny pentekosta"
msgstr "Lundi de Pentecôte"

#. Mother's Day.
msgid "Fetin'ny reny"
msgstr "Fête des Mères"

#. Father's Day.
msgid "Fetin'ny ray"
msgstr "Fête des Pères"

#. Independence Day.
msgid "Fetin'ny fahaleovantena"
msgstr "Jour de l'indépendance"

#. Assumption Day.
msgid "Fiakaran'ny Masina Maria tany an-danitra"
msgstr "Assomption"

#. All Saints' Day.
msgid "Fetin'ny olo-masina"
msgstr "Toussaint"

#. Republic Day.
msgid "Fetin'ny Repoblika"
msgstr "Jour de la République"

#. Christmas Day.
msgid "Fetin'ny noely"
msgstr "Noël"

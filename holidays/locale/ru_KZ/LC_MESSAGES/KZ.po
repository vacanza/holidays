#. %s (estimated).
#, c-format
msgid "%s (бағаланған)"
msgstr "%s (приблизительная дата)"

#. %s (observed).
#, c-format
msgid "%s (қайта белгіленген демалыс)"
msgstr "%s (выходной)"

#. %s (observed, estimated).
#, c-format
msgid "%s (қайта белгіленген демалыс, бағаланған)"
msgstr "%s (выходной, приблизительная дата)"

#. New Year's Day.
msgid "Жаңа жыл"
msgstr "Новый год"

#. Orthodox Christmas.
msgid "Православиелік Рождество"
msgstr "Православное Рождество"

#. International Women's Day.
msgid "Халықаралық әйелдер күні"
msgstr "Международный женский день"

#. Nowruz Holiday.
msgid "Наурыз мейрамы"
msgstr "Наурыз мейрамы"

#. Kazakhstan's People Solidarity Holiday.
msgid "Қазақстан халқының бірлігі мерекесі"
msgstr "Праздник единства народа Казахстана"

#. Defender of the Fatherland Day.
msgid "Отан Қорғаушы күні"
msgstr "День защитника Отечества"

#. Victory Day.
msgid "Жеңіс күні"
msgstr "День Победы"

#. Capital Day.
msgid "Астана күні"
msgstr "День Столицы"

#. Constitution Day.
msgid "Қазақстан Республикасының Конституциясы күні"
msgstr "День Конституции Республики Казахстан"

#. Republic Day.
msgid "Қазақстан Республикасы күні"
msgstr "День Республики Казахстан"

#. Republic Day.
msgid "Республика күні"
msgstr "День Республики"

#. First President Day.
msgid "Қазақстан Республикасының Тұңғыш Президенті күні"
msgstr "День Первого Президента Республики Казахстан"

#. Independence Day.
msgid "Тәуелсіздік күні"
msgstr "День Независимости"

#. Eid al-Adha.
msgid "Құрбан айт"
msgstr "Курбан-айт"

#. Substituted date format.
msgid "%d.%m.%Y"
msgstr "%d.%m.%Y"

#. Day off (substituted from %s).
#, c-format
msgid "Демалыс күні (%s бастап ауыстырылды)"
msgstr "Выходной (перенесено с %s)"

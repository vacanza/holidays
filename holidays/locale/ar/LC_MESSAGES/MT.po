#. New Year's Day.
msgid "L-Ewwel tas-Sena"
msgstr "رأس السنة الميلادية"

#. Feast of Saint Paul's Shipwreck.
msgid "Il-Festa tan-Nawfraġju ta' San Pawl"
msgstr "عيد تحطم سفينة القديس بولس"

#. Feast of Saint Joseph.
msgid "Il-Festa ta' San Ġużepp"
msgstr "عيد القديس يوسف"

#. Freedom Day.
msgid "Jum il-Ħelsien"
msgstr "يوم الحرية"

#. Good Friday.
msgid "Il-Ġimgħa l-Kbira"
msgstr "الجمعة العظيمة"

#. Worker's Day.
msgid "Jum il-Ħaddiem"
msgstr "عيد العمال"

#. Sette Giugno.
msgid "Sette Giugno"
msgstr "سيتي جونيو"

#. Feast of Saint Peter and Saint Paul.
msgid "Il-Festa ta' San Pietru u San Pawl"
msgstr "عيد القديسين بطرس وبولس"

#. Feast of the Assumption.
msgid "Il-Festa ta' Santa Marija"
msgstr "عيد انتقال السيدة العذراء"

#. Feast of Our Lady of Victories.
msgid "Jum il-Vitorja"
msgstr "عيد سيدة الانتصارات"

#. Independence Day.
msgid "Jum l-Indipendenza"
msgstr "عيد الاستقلال"

#. Feast of the Immaculate Conception
msgid "Il-Festa tal-Immakulata Kunċizzjoni"
msgstr "عيد الحبل بلا دنس"

#. Republic Day.
msgid "Jum ir-Repubblika"
msgstr "يوم الجمهورية"

#. Christmas Day.
msgid "Il-Milied"
msgstr "عيد الميلاد"

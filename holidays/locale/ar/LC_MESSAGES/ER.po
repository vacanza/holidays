#. %s (estimated).
#, c-format
msgid "%s (ግምት)"
msgstr "%s (تقديري)"

#. New Year's Day.
msgid "ሓዲሽ ዓመት"
msgstr "رأس السنة الميلادية"

#. Orthodox Christmas.
msgid "ልደት"
msgstr "عيد الميلاد الأرثوذكسي"

#. Epiphany.
msgid "ጥምቀት"
msgstr "عيد الغطاس"

#. Women's Day.
msgid "መዓልቲ ኣነስቲ"
msgstr "اليوم العالمي للمرأة"

#. Good Friday.
msgid "ዓርቢ ስቅለት"
msgstr "الجمعة العظيمة"

#. Orthodox Easter.
msgid "ፋሲካ"
msgstr "عيد القيامة الأرثوذكسي"

#. International Workers' Day.
msgid "ዓለማዊ መዓልቲ ሰራሕተኛታት"
msgstr "اليوم العالمي للعمال"

#. Independence Day.
msgid "መዓልቲ ናጽነት"
msgstr "عيد الاستقلال"

#. Martyrs' Day.
msgid "መዓልቲ ስውኣት"
msgstr "يوم الشهداء"

#. Revolution Day.
msgid "ባሕቲ መስከረም"
msgstr "عيد الثورة"

#. Ethiopian New Year.
msgid "ሓድሽ ዓመት ግእዝ"
msgstr "رأس السنة الجعزية"

#. Finding of the True Cross.
msgid "መስቀል"
msgstr "عيد الصليب"

#. Prophet's Birthday.
msgid "መውሊድ"
msgstr "المولد النبوي الشريف"

#. Eid al-Fitr.
msgid "ዒድ ኣልፈጥር"
msgstr "عيد الفطر"

#. Eid al-Adha.
msgid "ዒድ ኣልኣድሓ"
msgstr "عيد الأضحى"

#. Fenkil Day.
msgid "ፈንቅል"
msgstr "يوم فنكل"

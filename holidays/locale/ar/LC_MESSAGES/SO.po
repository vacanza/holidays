#. Prophet's Birthday.
msgid "Mowliidka Nebiga"
msgstr "المولد النبوي الشريف"

#. Isra' and Mi'raj.
msgid "Isra iyo Micraaj"
msgstr "الإسراء والمعراج"

#. Eid al-Fitr.
msgid "Ciidul Fitri"
msgstr "عيد الفطر"

#. Eid al-Adha.
msgid "Ciidul Adxa"
